# RoleBeacon binds to localhost by default.
ROLEBEACON_HOST=127.0.0.1
ROLEBEACON_PORT=8787
ROLEBEACON_AUTO_SYNC=true
ROLEBEACON_OPEN_BROWSER=false

# Optional overrides. The setup wizard stores these in the private application directory.
ROLEBEACON_DATA_DIR=
ROLEBEACON_LLM_MODE=rules
ROLEBEACON_LLM_BASE_URL=http://127.0.0.1:11434/v1
ROLEBEACON_LLM_MODEL=qwen3:8b
ROLEBEACON_LLM_API_KEY=
ROLEBEACON_LLM_TIMEOUT_SECONDS=120

# Optional Gmail read-only access for a dedicated LinkedIn job-alert label. The OAuth client and
# token are imported and stored by the setup wizard under the private application-data directory.
GMAIL_LABEL=Job Alerts

# Optional commercial aggregators remain disabled until explicitly configured.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
SERPAPI_API_KEY=
