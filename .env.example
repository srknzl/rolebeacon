# RoleBeacon binds to localhost by default.
ROLEBEACON_HOST=127.0.0.1
ROLEBEACON_PORT=8787
ROLEBEACON_AUTO_SYNC=true

# Whether "Prepare application" also opens a real browser window on the original posting and
# auto-fills the fields it can find (name, email, phone, website, GitHub, LinkedIn, résumé
# upload). It never submits. This is only the deploy-time default: once the app is running, the
# same choice is a checkbox next to the Prepare application button on each job's page, which
# persists to setup.json and overrides this value until the env var is set again.
ROLEBEACON_OPEN_BROWSER=false

# Optional overrides. The setup wizard stores these in the private application directory.
ROLEBEACON_DATA_DIR=
ROLEBEACON_LLM_MODE=rules
ROLEBEACON_LLM_BASE_URL=http://127.0.0.1:11434/v1
ROLEBEACON_LLM_MODEL=qwen3:8b
ROLEBEACON_LLM_API_KEY=
ROLEBEACON_LLM_TIMEOUT_SECONDS=120

# Optional commercial aggregators remain disabled until explicitly configured.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
SERPAPI_API_KEY=
